{
  "xsappname": "BackOrderHistory",
  "tenant-mode": "dedicated",
  "description": "Security config for Back Order History API",
  "scopes": [
    {
      "name": "$XSAPPNAME.read",
      "description": "Read back order history"
    }
  ],
  "role-templates": [
    {
      "name": "BackOrderViewer",
      "description": "Can read back order history",
      "scope-references": [
        "$XSAPPNAME.read"
      ]
    }
  ],
  "role-collections": [
    {
      "name": "BackOrderHistory_Viewer",
      "description": "BackOrder History Viewer",
      "role-template-references": [
        "$XSAPPNAME.BackOrderViewer"
      ]
    }
  ],
  "oauth2-configuration": {
    "redirect-uris": [
      "https://*.cfapps.us10-001.hana.ondemand.com/**"
    ]
  }
}
